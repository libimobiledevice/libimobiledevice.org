{% extends 'partials/container.html.twig' %}

{% block container_content %}
<nav aria-label="breadcrumb">
<ol class="breadcrumb">
  <li class="breadcrumb-item"><a href="{{ url('/') }}">Home</a></li>
  {% if page.section is not empty and page.type == 'page' %}
  {% set section = page.parent ?? (site.pages | filter(v => v.id == page.section) | first) %}
  {% if section %}
  <li class="breadcrumb-item"><a href="{{ url(section) }}">{{ section.title }}</a></li>
  {% endif %}
  {% endif %}
  {% if page.type == 'page' %}
  <li class="breadcrumb-item active" aria-current="page">{{ page.title }}</li>
  {% endif %}
  {% if page.type == 'section' %}
  <li class="breadcrumb-item active" aria-current="page">{{ page.title }}</li>
  {% endif %}
</ol>
</nav>
{% endblock %}